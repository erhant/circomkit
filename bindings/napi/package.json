{
  "name": "circomkit",
  "version": "0.4.0",
  "description": "Circom development & testing toolkit — native bindings (napi-rs)",
  "license": "MIT",
  "repository": "https://github.com/erhant/circomkit",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "circomkit": "bin.js"
  },
  "files": ["index.js", "index.d.ts", "binding.js", "binding.d.ts", "bin.js", "*.node"],
  "napi": {
    "binaryName": "circomkit",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 20"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "napi build --release --platform --js binding.js --dts binding.d.ts && tsc",
    "build:debug": "napi build --platform --js binding.js --dts binding.d.ts && tsc",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm"
  }
}
